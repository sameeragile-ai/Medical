# Vercel's Postgres storage integration (powered by Neon) fills this in
# automatically when you attach it to your project in the Vercel dashboard.
# For local development, or another host (Neon, Supabase, Railway, etc.),
# paste a Postgres connection string here.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Single shared password for the whole application (inventory + inquiries).
ADMIN_PASSWORD="change-me-admin"
